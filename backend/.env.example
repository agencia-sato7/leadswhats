APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Relatório diário de IA (leadswhats:daily-report, agendado a cada 5 minutos pelo
# serviço "scheduler" do docker-compose e enviado via fila para o queue-worker):
# - o horário de disparo é 18:30 no timezone de cada empresa
#   (company_business_settings.timezone, com queda para companies.timezone);
# - o destinatário é o e-mail do cadastro da clínica (daily_report_recipient em
#   company_business_settings, informado na Central da Agência); sem e-mail o
#   relatório do dia fica "skipped", sem chamada de IA e sem envio;
# - em local/testes MAIL_MAILER=log escreve o HTML no storage/logs; em produção
#   configure um MAIL_MAILER smtp com host/porta/credenciais reais.
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.exemplo.com
# MAIL_PORT=587
# MAIL_USERNAME=usuario
# MAIL_PASSWORD=senha

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp: use fake apenas em desenvolvimento/testes. Production exige meta_cloud.
WHATSAPP_PROVIDER=fake
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
# Opcional: usada apenas quando o app exigir redirect_uri na troca do code.
# No fluxo de Coexistência (Embedded Signup para WhatsApp Business app) a
# troca do code não exige redirect_uri.
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v25.0
META_HTTP_CONNECT_TIMEOUT_SECONDS=5
META_HTTP_TIMEOUT_SECONDS=15

# Coexistência (WhatsApp Business app user onboarding)
# ID da Facebook Login for Business Configuration criada com o produto
# "WhatsApp Business app user onboarding". É um identificador público e é
# exposto ao frontend pelo GET /api/v1/settings/whatsapp.
META_COEXISTENCE_CONFIG_ID=1088502166986777
META_COEXISTENCE_FEATURE_TYPE=whatsapp_business_app_onboarding
META_COEXISTENCE_SESSION_INFO_VERSION=3
# Dispara a sincronização de contatos + histórico (smb_app_data) ao conectar.
META_COEXISTENCE_AUTO_SYNC=true

# Conversation Intelligence: fake somente quando escolhido explicitamente em local/testing.
CONVERSATION_ANALYZER=python
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT_SECONDS=90
AI_SERVICE_CONNECT_TIMEOUT_SECONDS=5
