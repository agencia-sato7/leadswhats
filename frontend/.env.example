# URL base da API consumida pelo frontend.
# Local (backend no docker-compose na porta 9000): http://localhost:9000/api/v1
VITE_API_BASE_URL=https://leadswhats.appsato7.com.br/api/v1

# Identificadores públicos da Meta (nunca são segredos).
# O backend também os expõe em GET /api/v1/settings/whatsapp; estas variáveis
# servem apenas como fallback do build do frontend.
VITE_META_APP_ID=
# Config_id da Facebook Login for Business Configuration com o produto
# "WhatsApp Business app user onboarding" (Coexistência).
VITE_META_COEXISTENCE_CONFIG_ID=1088502166986777